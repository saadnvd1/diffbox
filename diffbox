# ---------------------------------------------------------------- git helpers


class GitError(Exception):
    pass


class Repo:
    def __init__(self, path: Path):
        self.root = self._toplevel(path)

    @staticmethod
    def _toplevel(path: Path) -> Path:
        try:
            out = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                cwd=str(path), capture_output=True, text=True, check=True,
            ).stdout.strip()
        except subprocess.CalledProcessError:
            raise GitError(f"not a git repository: {path}")
        return Path(out)

    def run(self, args, stdin=None, check=True):
        p = subprocess.run(
            ["git"] + args, cwd=str(self.root),
            input=stdin, capture_output=True, text=True,
        )
        if check and p.returncode != 0:
            raise GitError((p.stderr or p.stdout).strip() or f"git {' '.join(args)} failed")
        return p

    def run_bytes(self, args):
        return subprocess.run(
            ["git"] + args, cwd=str(self.root), capture_output=True
        ).stdout

    # -- state ----------------------------------------------------------

    def branch(self):
        p = self.run(["rev-parse", "--abbrev-ref", "HEAD"], check=False)
        name = p.stdout.strip()
        return name if p.returncode == 0 and name else "(no commits)"

    def has_head(self):
        return self.run(["rev-parse", "--verify", "HEAD"], check=False).returncode == 0

    def status(self):
        """Working tree vs HEAD, the way a WIP node reads in GitKraken."""
        raw = self.run_bytes(["status", "--porcelain=v1", "-z", "--untracked-files=all"])
        entries, parts, i = [], raw.split(b"\x00"), 0
        while i < len(parts):
            chunk = parts[i]
            i += 1
            if not chunk:
                continue
            code, path = chunk[:2].decode(), chunk[3:].decode("utf-8", "replace")
            orig = None
            if code[0] in ("R", "C"):  # rename/copy: next NUL field is the source
                orig = parts[i].decode("utf-8", "replace") if i < len(parts) else None
                i += 1
            entries.append((code, path, orig))

        stats = self._numstat()
        files = []
        for code, path, orig in entries:
            untracked = code == "??"
            adds, dels, binary = stats.get(path, (0, 0, False))
            if untracked:
                adds, binary = self._count_new_file(path)
                dels = 0
            files.append({
                "path": path,
                "orig": orig,
                "status": self._label(code, untracked),
                "code": code,
                "staged": code[0] not in (" ", "?"),
                "unstaged": code[1] not in (" ", "?") or untracked,
                "untracked": untracked,
                "adds": adds,
                "dels": dels,
                "binary": binary,
            })
        files.sort(key=lambda f: f["path"])
        return files

    def _numstat(self):
        if not self.has_head():
            return {}
        out = self.run(["diff", "HEAD", "--numstat", "-z"], check=False).stdout
        stats = {}
        fields = out.split("\x00")
        i = 0
        while i < len(fields):
            rec = fields[i]
            i += 1
            if not rec.strip():
                continue
            try:
                a, d, name = rec.split("\t")
            except ValueError:
                continue
            if name == "":  # rename: two more NUL fields (old, new)
                i += 1
                name = fields[i] if i < len(fields) else ""
                i += 1
            binary = a == "-" or d == "-"
            stats[name] = (0 if binary else int(a), 0 if binary else int(d), binary)
        return stats

    def _count_new_file(self, path):
        f = self.root / path
        try:
            data = f.read_bytes()
        except OSError:
            return 0, False
        if b"\x00" in data[:8000]:
            return 0, True
        if not data:
            return 0, False
        return data.count(b"\n") + (0 if data.endswith(b"\n") else 1), False

    @staticmethod
    def _label(code, untracked):
        if untracked:
            return "new"
        letters = {"A": "added", "D": "deleted", "M": "modified",
                   "R": "renamed", "C": "copied", "U": "conflict", "T": "typechange"}
        for ch in code:
            if ch in letters:
                return letters[ch]
        return "modified"

    # -- diff -----------------------------------------------------------

    def raw_diff(self, path, untracked=False):
        if untracked:
            return self.run(
                ["diff", "--no-color", "--no-ext-diff", "-U3",
                 "--no-index", "--", os.devnull, path],
                check=False,
            ).stdout
        base = ["diff", "--no-color", "--no-ext-diff", "-U3"]
        if self.has_head():
            base.append("HEAD")
        return self.run(base + ["--", path], check=False).stdout

    def diff(self, path, untracked=False):
        text = self.raw_diff(path, untracked)
        if not text.strip():
            return {"path": path, "binary": False, "hunks": [], "empty": True}
        if re.search(r"^Binary files ", text, re.M) or "GIT binary patch" in text:
            return {"path": path, "binary": True, "hunks": [], "empty": False}
        return {"path": path, "binary": False, "hunks": parse_hunks(text), "empty": False}

    # -- destructive ----------------------------------------------------

    def discard_file(self, path, untracked=False):
        if untracked:
            target = (self.root / path).resolve()
            if not str(target).startswith(str(self.root.resolve())):
                raise GitError("refusing to touch a path outside the repo")
            if target.is_file() or target.is_symlink():
                target.unlink()
            return
        if self.has_head():
            self.run(["restore", "--source=HEAD", "--staged", "--worktree", "--", path])
        else:
            self.run(["rm", "-f", "--cached", "--", path], check=False)
            (self.root / path).unlink(missing_ok=True)

    def discard_hunk(self, path, index, untracked=False):
        if untracked:
            raise GitError("that file is untracked — discard the whole file instead")
        text = self.raw_diff(path)
        header, hunks = split_patch(text)
        if index < 0 or index >= len(hunks):
            raise GitError("that hunk is gone — refresh and try again")
        # A partially staged file cannot be reverse-applied to the worktree
        # alone without desyncing the index, so unstage it first.
        code = next((f["code"] for f in self.status() if f["path"] == path), "  ")
        if code[0] not in (" ", "?"):
            self.run(["restore", "--staged", "--", path], check=False)
        patch = header + hunks[index]
        if not patch.endswith("\n"):
            patch += "\n"
        p = self.run(["apply", "--reverse", "--unidiff-zero", "-"], stdin=patch, check=False)
        if p.returncode != 0:
            raise GitError(p.stderr.strip() or "could not discard that hunk")

    def discard_all(self, include_untracked=False):
        if self.has_head():
            self.run(["reset", "--hard", "HEAD"])
        else:
            self.run(["rm", "-rf", "--cached", "."], check=False)
        if include_untracked:
            self.run(["clean", "-fd"])


# ------------------------------------------------------------ patch parsing

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$")


def split_patch(text):
    """Return (file header, [hunk texts]) for a single-file unified diff."""
    lines = text.splitlines(keepends=True)
    header, hunks, cur = [], [], None
    for line in lines:
        if line.startswith("@@"):
            if cur is not None:
                hunks.append("".join(cur))
            cur = [line]
        elif cur is None:
            header.append(line)
        else:
            cur.append(line)
    if cur is not None:
        hunks.append("".join(cur))
    return "".join(header), hunks


def parse_hunks(text):
    """Unified diff -> side-by-side rows."""
    _, raw_hunks = split_patch(text)
    out = []
    for h_index, raw in enumerate(raw_hunks):
        lines = raw.splitlines()
        m = HUNK_RE.match(lines[0])
        if not m:
            continue
        old_no, new_no = int(m.group(1)), int(m.group(3))
        rows, dels, adds = [], [], []

        def flush():
            nonlocal dels, adds
            for i in range(max(len(dels), len(adds))):
                left = dels[i] if i < len(dels) else None
                right = adds[i] if i < len(adds) else None
                if left and right:
                    lseg, rseg = inline_segments(left[1], right[1])
                    rows.append({"type": "mod", "oldNo": left[0], "newNo": right[0],
                                 "old": lseg, "new": rseg})
                elif left:
                    rows.append({"type": "del", "oldNo": left[0], "newNo": None,
                                 "old": [[left[1], False]], "new": None})
                else:
                    rows.append({"type": "add", "oldNo": None, "newNo": right[0],
                                 "old": None, "new": [[right[1], False]]})
            dels, adds = [], []

        for line in lines[1:]:
            if not line:
                line = " "
            tag, body = line[0], line[1:]
            if tag == "\\":  # "\ No newline at end of file"
                continue
            if tag == "-":
                dels.append((old_no, body)); old_no += 1
            elif tag == "+":
                adds.append((new_no, body)); new_no += 1
            else:
                flush()
                rows.append({"type": "ctx", "oldNo": old_no, "newNo": new_no,
                             "old": [[body, False]], "new": [[body, False]]})
                old_no += 1; new_no += 1
        flush()
        out.append({"index": h_index, "header": m.group(5).strip(), "rows": rows})
    return out


def inline_segments(a, b):
    """Char-level highlight for a changed line pair, GitKraken-style."""
    if len(a) > 600 or len(b) > 600:
        return [[a, True]], [[b, True]]
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if sm.quick_ratio() < 0.3:
        return [[a, True]], [[b, True]]
    left, right = [], []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            if i2 > i1:
                left.append([a[i1:i2], False])
            if j2 > j1:
                right.append([b[j1:j2], False])
        else:
            if i2 > i1:
                left.append([a[i1:i2], True])
            if j2 > j1:
                right.append([b[j1:j2], True])
    return left or [["", False]], right or [["", False]]


