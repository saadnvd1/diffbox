let files = [], sel = null, sig = "", busy = false;

const esc = s => s.replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const segs = parts => parts ? parts.map(([t, hi]) => hi ? `<i class="h">${esc(t)}</i>` : esc(t)).join("") : "";

function toast(msg, kind) {
  const t = $("#toast");
  t.textContent = msg; t.className = kind || ""; t.hidden = false;
  clearTimeout(t._t); t._t = setTimeout(() => t.hidden = true, kind === "err" ? 6000 : 2200);
}

async function api(path, opts) {
  const r = await fetch(path, opts);
  const data = await r.json().catch(() => ({ error: "bad response" }));
  if (!r.ok || data.error) throw new Error(data.error || r.statusText);
  return data;
}

// ---- rendering -----------------------------------------------------------

function splitPath(p) {
  const i = p.lastIndexOf("/");
  return i < 0 ? ["", p] : [p.slice(0, i + 1), p.slice(i + 1)];
}

function renderFiles() {
  $("#fcount").textContent = files.length;
  const adds = files.reduce((n, f) => n + f.adds, 0), dels = files.reduce((n, f) => n + f.dels, 0);
  $("#totals").textContent = files.length ? `+${adds} −${dels}` : "";
  const box = $("#files");
  box.innerHTML = files.map((f, i) => {
    const [dir, base] = splitPath(f.path);
    const letter = { modified: "M", new: "U", added: "A", deleted: "D", renamed: "R",
                     copied: "C", conflict: "!", typechange: "T" }[f.status] || "M";
    return `<div class="file${f.path === sel ? " sel" : ""}" data-i="${i}" title="${esc(f.path)}">
      <span class="mark ${f.status}">${letter}</span>
      <span class="name"><span>${esc(dir)}</span><b>${esc(base)}</b></span>
      ${f.staged ? '<span class="staged-dot" title="has staged changes"></span>' : ""}
      <span class="stat">${f.binary ? "bin" : `<span class="a">+${f.adds}</span> <span class="d">−${f.dels}</span>`}</span>
      <button class="x" data-discard="${i}" title="Discard this file">✕</button>
    </div>`;
  }).join("");
  box.querySelectorAll(".file").forEach(el => {
    el.onclick = e => {
      if (e.target.dataset.discard !== undefined) return;
      select(files[+el.dataset.i].path);
    };
  });
  box.querySelectorAll("[data-discard]").forEach(el => {
    el.onclick = e => { e.stopPropagation(); confirmFile(files[+el.dataset.discard]); };
  });
}

function renderDiff(d) {
  const pane = $("#diff");
  if (!d) {
    $("#diffHead").hidden = true;
    pane.innerHTML = files.length
      ? `<div class="empty"><div><div class="big">Pick a file</div><kbd>j</kbd> / <kbd>k</kbd> to move · <kbd>r</kbd> refresh · <kbd>w</kbd> wrap</div></div>`
      : `<div class="empty"><div><div class="big">Working tree clean</div>Nothing to review.</div></div>`;
    return;
  }
  const [dir, base] = splitPath(d.path);
  $("#diffHead").hidden = false;
  $("#diffPath").innerHTML = `<span>${esc(dir)}</span>${esc(base)}`;
  if (d.binary)  { pane.innerHTML = `<div class="empty">Binary file — no text diff.</div>`; return; }
  if (d.empty)   { pane.innerHTML = `<div class="empty">No textual changes.</div>`; return; }
  pane.innerHTML = d.hunks.map(h => `<div class="hunk">
    <div class="hunk-head">
      <span>@@ ${esc(h.header) || `hunk ${h.index + 1}`}</span>
      <span class="spacer"></span>
      <button class="btn danger" data-hunk="${h.index}">Discard hunk</button>
    </div>
    <table class="sbs"><tbody>${h.rows.map(r => `<tr class="${r.type}">
      <td class="n">${r.oldNo ?? ""}</td><td class="c l">${segs(r.old)}</td>
      <td class="n">${r.newNo ?? ""}</td><td class="c r">${segs(r.new)}</td>
    </tr>`).join("")}</tbody></table></div>`).join("");
  pane.querySelectorAll("[data-hunk]").forEach(el => {
    el.onclick = () => confirmHunk(d.path, +el.dataset.hunk);
  });
  pane.scrollTop = 0;
}

// ---- data ----------------------------------------------------------------

async function load(keepScroll) {
  const st = await api("/api/status");
  $("#repo").textContent = st.repo;
  $("#branch").textContent = st.branch;
  document.title = `${st.repo} — diffbox`;
  files = st.files;
  if (st.sig === sig && keepScroll) return;
  sig = st.sig;
  if (sel && !files.some(f => f.path === sel)) sel = null;
  if (!sel && files.length) sel = files[0].path;
  renderFiles();
  await showDiff();
}

async function showDiff() {
  if (!sel) return renderDiff(null);
  const f = files.find(x => x.path === sel);
  try {
    renderDiff(await api(`/api/diff?path=${encodeURIComponent(sel)}&untracked=${f && f.untracked ? 1 : 0}`));
  } catch (e) { toast(e.message, "err"); }
}

function select(path) { sel = path; renderFiles(); showDiff(); }

// ---- destructive ---------------------------------------------------------

function ask(title, bodyHtml, okLabel) {
  return new Promise(resolve => {
    $("#mTitle").textContent = title;
    $("#mBody").innerHTML = bodyHtml;
    $("#mOk").textContent = okLabel || "Discard";
    $("#veil").hidden = false;
    $("#mOk").focus();
    const done = v => { $("#veil").hidden = true; document.removeEventListener("keydown", key, true); resolve(v); };
    const key = e => {
      if (e.key === "Escape") { e.stopPropagation(); done(false); }
      if (e.key === "Enter") { e.stopPropagation(); done(true); }
    };
    document.addEventListener("keydown", key, true);
    $("#mOk").onclick = () => done(true);
    $("#mCancel").onclick = () => done(false);
    $("#veil").onclick = e => { if (e.target.id === "veil") done(false); };
  });
}

async function post(url, body) {
  if (busy) return;
  busy = true;
  try {
    const r = await api(url, { method: "POST", headers: { "Content-Type": "application/json" },
                               body: JSON.stringify(body) });
    sig = "";
    await load();
    toast(r.message || "Discarded", "ok");
  } catch (e) { toast(e.message, "err"); }
  finally { busy = false; }
}

async function confirmFile(f) {
  if (!f) return;
  const what = f.untracked ? "delete this untracked file" : "restore this file to HEAD";
  if (!await ask("Discard file?",
      `<p>This will ${what}. It cannot be undone.</p><p><code>${esc(f.path)}</code></p>`)) return;
  await post("/api/discard-file", { path: f.path, untracked: !!f.untracked });
}

async function confirmHunk(path, index) {
  if (!await ask("Discard hunk?",
      `<p>Reverts just this hunk in the working tree.</p><p><code>${esc(path)}</code></p>`)) return;
  await post("/api/discard-hunk", { path, index });
}

$("#discardAll").onclick = async () => {
  if (!files.length) return toast("Nothing to discard");
  const untracked = files.filter(f => f.untracked).length;
  const ok = await ask("Discard ALL changes?",
    `<p>Resets <b>${files.length}</b> file(s) in <code>${esc($("#repo").textContent)}</code> back to HEAD. This cannot be undone.</p>` +
    (untracked ? `<label><input type="checkbox" id="mClean"> Also delete ${untracked} untracked file(s)</label>` : ""),
    "Discard everything");
  if (!ok) return;
  await post("/api/discard-all", { untracked: !!(document.getElementById("mClean") || {}).checked });
};

// ---- chrome --------------------------------------------------------------

$("#refresh").onclick = () => { sig = ""; load().catch(e => toast(e.message, "err")); };
$("#discardFile").onclick = () => confirmFile(files.find(f => f.path === sel));
function syncWrap() {
  const off = document.body.classList.contains("nowrap");
  $("#wrap").textContent = off ? "Wrap" : "No wrap";
  localStorage.setItem("nowrap", off ? "1" : "0");
}
$("#wrap").onclick = () => { document.body.classList.toggle("nowrap"); syncWrap(); };
if (localStorage.getItem("nowrap") === "1") document.body.classList.add("nowrap");
syncWrap();

document.addEventListener("keydown", e => {
  if (!$("#veil").hidden || e.metaKey || e.ctrlKey) return;
  const i = files.findIndex(f => f.path === sel);
  if (e.key === "j" || e.key === "ArrowDown") { if (files[i + 1]) select(files[i + 1].path); e.preventDefault(); }
  if (e.key === "k" || e.key === "ArrowUp")   { if (files[i - 1]) select(files[i - 1].path); e.preventDefault(); }
  if (e.key === "r") $("#refresh").click();
  if (e.key === "w") $("#wrap").click();
  if (e.key === "d") $("#discardFile").click();
});

load().catch(e => toast(e.message, "err"));
setInterval(() => { if (!document.hidden && !busy && $("#veil").hidden) load(true).catch(() => {}); }, 2000);
</script>
</body>
</html>
"""


# ----------------------------------------------------------------- http glue


class Handler(BaseHTTPRequestHandler):
    server_version = "diffbox"
    repo: Repo = None

    def log_message(self, *_):
        pass

    # -- plumbing -------------------------------------------------------

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(data)
        except BrokenPipeError:
            pass

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj))

    def _err(self, msg, code=400):
        self._json({"error": str(msg)}, code)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    # -- routes ---------------------------------------------------------

    def do_GET(self):
        url = urlparse(self.path)
        q = parse_qs(url.query)
        try:
            if url.path == "/":
                return self._send(200, INDEX_HTML, "text/html; charset=utf-8")
            if url.path == "/api/status":
                files = self.repo.status()
                return self._json({
                    "repo": self.repo.root.name,
                    "root": str(self.repo.root),
                    "branch": self.repo.branch(),
                    "files": files,
                    "sig": self._sig(files),
                })
            if url.path == "/api/diff":
                path = (q.get("path") or [""])[0]
                untracked = (q.get("untracked") or ["0"])[0] == "1"
                if not path:
                    return self._err("missing path")
                return self._json(self.repo.diff(path, untracked))
            self._err("not found", 404)
        except GitError as e:
            self._err(e)
        except Exception as e:  # keep the UI alive with a readable message
            self._err(f"{type(e).__name__}: {e}", 500)

    def do_POST(self):
        url = urlparse(self.path)
        try:
            b = self._body()
            if url.path == "/api/discard-file":
                self.repo.discard_file(b["path"], bool(b.get("untracked")))
                return self._json({"ok": True, "message": f"Discarded {b['path']}"})
            if url.path == "/api/discard-hunk":
                self.repo.discard_hunk(b["path"], int(b["index"]), bool(b.get("untracked")))
                return self._json({"ok": True, "message": "Hunk discarded"})
            if url.path == "/api/discard-all":
                n = len(self.repo.status())
                self.repo.discard_all(bool(b.get("untracked")))
                return self._json({"ok": True, "message": f"Discarded {n} file(s)"})
            self._err("not found", 404)
        except GitError as e:
            self._err(e)
        except KeyError as e:
            self._err(f"missing field {e}")
        except Exception as e:
            self._err(f"{type(e).__name__}: {e}", 500)

    def _sig(self, files):
        """Cheap change token: status + sizes/mtimes of the changed files."""
        bits = []
        for f in files:
            p = self.repo.root / f["path"]
            try:
                st = p.stat()
                bits.append(f"{f['path']}:{f['code']}:{st.st_size}:{st.st_mtime_ns}")
            except OSError:
                bits.append(f"{f['path']}:{f['code']}:-")
        return str(hash("|".join(bits)))


class Server(ThreadingMixIn, HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    ap = argparse.ArgumentParser(prog="diffbox", description="A very light GitKraken.")
    ap.add_argument("repo", nargs="?", default=".", help="repository path (default: cwd)")
    ap.add_argument("-p", "--port", type=int, default=int(os.environ.get("DIFFBOX_PORT", DEFAULT_PORT)))
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    args = ap.parse_args()

    try:
        repo = Repo(Path(args.repo).expanduser().resolve())
    except GitError as e:
        print(f"diffbox: {e}", file=sys.stderr)
        return 2

    Handler.repo = repo
    port = args.port
    for attempt in range(20):
        try:
            httpd = Server((BIND_HOST, port), Handler)
            break
        except OSError:
            port += 1
    else:
        print(f"diffbox: no free port near {args.port}", file=sys.stderr)
        return 1

    url = f"http://{BIND_HOST}:{port}"
    print(f"diffbox  {repo.root}  ({repo.branch()})\n         {url}   ctrl-c to stop")
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
